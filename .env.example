# Copy this file to `.env` and fill in your own values.
# The contact form (src/app/api/contact/route.js) uses these to send email
# via Gmail. EMAIL_PASS must be a Gmail "App Password", not your login password.

EMAIL_USER=you@example.com
EMAIL_PASS=your_gmail_app_password
RECEIVER_EMAIL=you@example.com

## Environment variables that are prefixed with NEXT_PUBLIC_ are exposed to the browser.
## Public (dummy) contact values for examples
# Set these to the email and phone number you want displayed publicly in the UI.
NEXT_PUBLIC_EMAIL_USER=you@example.com
NEXT_PUBLIC_PHONE=+1 234 567 8900
